# MySQL
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=sentinel_k8s
MYSQL_USER=sentinel
MYSQL_PASSWORD=sentinel_pass

# Seed admin password (only used on first run when no users exist)
SEED_ADMIN_PASSWORD=admin

# Event poller (set to false when using event-exporter in the cluster)
EVENT_POLL_ENABLED=true
EVENT_POLL_INTERVAL=60
