FROM python:3.12-slim

WORKDIR /app

COPY webhook/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY webhook/webhook_receiver.py .
COPY webhook/mcp_server.py .
COPY webhook/database.py .

EXPOSE 8000

CMD ["uvicorn", "webhook_receiver:app", "--host", "0.0.0.0", "--port", "8000"]
