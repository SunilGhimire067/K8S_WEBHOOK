# Stage 1: Build
FROM node:20-alpine AS build

WORKDIR /app

COPY chat_ui/frontend/package.json chat_ui/frontend/package-lock.json* ./
RUN npm ci

COPY chat_ui/frontend/ ./

# Set the API base to empty string so nginx proxies /api/* to backend
ENV VITE_API_BASE=""
RUN npm run build

# Stage 2: Serve
FROM nginx:alpine

COPY chat_ui/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
